{
  "name": "medapp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend for the medical appointments and clinical history registry",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "migrate:down": "node dist/database/rollback.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "multer": "1.4.5-lts.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
